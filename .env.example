NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Ne jamais mettre de clé service_role (SUPABASE_SECRET_KEY / service_role) dans un dépôt frontend.
# Ces clés contourne le RLS et ne doivent exister que côté serveur/CI.

# Mode démonstration sans base — local uniquement, jamais en production.
# Sans variables Supabase et sans ce flag, /dashboard lève une erreur (fail-closed).
# NEXT_PUBLIC_MEDISTOCK_DEMO=1
